1:["$","main",null,{"children":[["$","section",null,{"className":"page-hero","children":["$","div",null,{"className":"container","children":[["$","span",null,{"className":"eyebrow","children":"Dúvidas objetivas"}],["$","h1",null,{"children":"Antes de instalar, saiba como funciona."}],["$","p",null,{"children":"Compatibilidade, licenças, atualizações e rotina de uso explicadas de forma direta."}]]}]}],["$","section",null,{"className":"faq-section","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"faq-layout","children":[["$","aside",null,{"children":[["$","span",null,{"className":"eyebrow","children":"Neste FAQ"}],["$","h2",null,{"children":"Informações essenciais"}],["$","p",null,{"children":"Compatibilidade, internet, dados, licenciamento, atualizações e uso pela equipe."}],["$","$L6",null,{"className":"btn btn-primary","href":"/guia","children":"Abrir o guia completo","prefetch":false}]]}],["$","div",null,{"className":"faq-list","children":[["$","details","Para quem o aplicativo foi desenvolvido?",{"open":true,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"Para quem o aplicativo foi desenvolvido?"}],["$","i",null,{"className":"bi bi-plus-lg"}]]}],["$","p",null,{"children":"Para assistências técnicas, lojas de celulares e informática, técnicos independentes e negócios que precisam controlar entrada e saída de equipamentos, orçamentos, manutenção, documentos e garantia."}]]}],["$","details","Preciso instalar alguma coisa?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"Preciso instalar alguma coisa?"}],["$","i",null,{"className":"bi bi-plus-lg"}]]}],["$","p",null,{"children":"Sim. O aplicativo completo é instalado no computador Windows 64 bits da assistência. O instalador inclui os termos e prepara a estrutura local necessária."}]]}],["$","details","Em quais computadores o aplicativo funciona?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"Em quais computadores o aplicativo funciona?"}],["$","i",null,{"className":"bi bi-plus-lg"}]]}],["$","p",null,{"children":"A versão atual é feita para Windows 10 ou Windows 11 em 64 bits. Ela é instalada no computador principal da assistência. O painel operacional completo fica nesse computador; o convite individual de avaliação pode ser aberto pelo técnico em outro computador ou celular durante as 24 horas de validade."}]]}],["$","details","Precisa de internet para trabalhar?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"Precisa de internet para trabalhar?"}],["$","i",null,{"className":"bi bi-plus-lg"}]]}],["$","p",null,{"children":"Os dados operacionais ficam no computador. Depois de uma validação online válida, a janela offline assinada pode chegar a 24 horas, sem ultrapassar o vencimento comercial ou o fim do teste. O cabeçalho avisa quando a conexão cai; é preciso reconectar dentro desse prazo para renovar a licença, receber revogações e usar sincronização e atualizações."}]]}],["$","details","Onde os dados ficam salvos?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"Onde os dados ficam salvos?"}],["$","i",null,{"className":"bi bi-plus-lg"}]]}],["$","p",null,{"children":"O banco principal fica no computador da loja em SQLite criptografado. O aplicativo oferece backups protegidos e uma cópia externa configurável. Quando a sincronização estiver habilitada e autorizada, os eventos previstos nos termos podem seguir para a infraestrutura do produto."}]]}],["$","details","Como a licença é ativada?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"Como a licença é ativada?"}],["$","i",null,{"className":"bi bi-plus-lg"}]]}],["$","p",null,{"children":"Na primeira abertura, informe no aplicativo a chave de ativação recebida após a compra. A autorização é vinculada à instalação e o acesso só é liberado depois da confirmação da chave."}]]}],["$","details","Posso usar a mesma licença em mais de um computador?",{"open":false,"children":["$L11","$L12"]}],"$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23"]}]]}],"$L24"]}]}]]}]
11:["$","summary",null,{"children":[["$","span",null,{"children":"Posso usar a mesma licença em mais de um computador?"}],["$","i",null,{"className":"bi bi-plus-lg"}]]}]
12:["$","p",null,{"children":"A contratação padrão autoriza um computador por licença. Para transferir o uso ou contratar outra ativação, fale com o suporte."}]
13:["$","details","O que acontece quando a licença vence?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"O que acontece quando a licença vence?"}],["$","i",null,{"className":"bi bi-plus-lg"}]]}],["$","p",null,{"children":"Os dados permanecem preservados no computador. As funções comerciais aguardam uma renovação ou nova ativação válida."}]]}]
14:["$","details","A licença permanente vence?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"A licença permanente vence?"}],["$","i",null,{"className":"bi bi-plus-lg"}]]}],["$","p",null,{"children":"A modalidade permanente não possui data final de uso e continua sujeita às regras de uso, revogação e transferência previstas nos termos."}]]}]
15:["$","details","Todos os planos possuem os mesmos recursos?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"Todos os planos possuem os mesmos recursos?"}],["$","i",null,{"className":"bi bi-plus-lg"}]]}],["$","p",null,{"children":"Sim. A diferença entre 1 mês, 6 meses, 1 ano e permanente é o período da licença. Alguns módulos operacionais, como comércio de aparelhos e estoque, podem ser ligados ou desligados pela própria empresa para adaptar a interface à rotina, sem mudar o plano contratado nem apagar o histórico."}]]}]
16:["$","details","Quanto custa a licença?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"Quanto custa a licença?"}],["$","i",null,{"className":"bi bi-plus-lg"}]]}],["$","p",null,{"children":"A licença mensal custa R$ 27,99; a semestral, R$ 47,99; a anual, R$ 77,99; e a permanente, R$ 119,99. A compra é combinada diretamente pelo WhatsApp, sem cobrança automática no site."}]]}]
17:["$","details","Posso testar antes de comprar?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"Posso testar antes de comprar?"}],["$","i",null,{"className":"bi bi-plus-lg"}]]}],["$","p",null,{"children":"Sim. O teste grátis libera o aplicativo por 1 dia para conhecer os recursos e o modo demonstração. A solicitação é feita pelo WhatsApp e não exige pagamento."}]]}]
18:["$","details","O sistema gera documentos e permite impressão?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"O sistema gera documentos e permite impressão?"}],["$","i",null,{"className":"bi bi-plus-lg"}]]}],["$","p",null,{"children":"Sim. O sistema prepara orçamento, ordem de serviço, comprovante de retirada, ficha técnica, garantia, etiquetas, compra e venda de aparelhos, transferência de dados, pós-formatação e relatórios. Os arquivos são baixados automaticamente e podem ser impressos conforme o fluxo."}]]}]
19:["$","details","Como funciona a garantia?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"Como funciona a garantia?"}],["$","i",null,{"className":"bi bi-plus-lg"}]]}],["$","p",null,{"children":"A garantia é aberta a partir de um orçamento finalizado. Ela mantém cliente, aparelho e origem do atendimento, registra avaliação, decisão, andamento e responsável, e permite gerar comprovante. Exclusões exigem permissão e confirmação."}]]}]
1a:["$","details","Posso configurar validade, arquivamento e vencimento dos orçamentos?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"Posso configurar validade, arquivamento e vencimento dos orçamentos?"}],["$","i",null,{"className":"bi bi-plus-lg"}]]}],["$","p",null,{"children":"Sim. A loja define a validade padrão e pode ajustar cada orçamento. Por padrão, o vencimento ocorre em 30 dias e as pendências de aprovação podem ser arquivadas após 7 dias. A expiração automática, os dias úteis e os lembretes podem ser configurados em Administração."}]]}]
1b:["$","details","Como o técnico informa diagnóstico e valores à distância?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"Como o técnico informa diagnóstico e valores à distância?"}],["$","i",null,{"className":"bi bi-plus-lg"}]]}],["$","p",null,{"children":"Em Aguardando técnico, a loja pode enviar um link individual válido por 24 horas. O técnico vê apenas o atendimento necessário e informa o defeito constatado, o resultado da avaliação e uma ou mais alternativas de peça e valor por serviço. A resposta gera um aviso e só altera o orçamento depois da revisão e confirmação da loja."}]]}]
1c:["$","details","As notificações continuam aparecendo se eu não visualizar?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"As notificações continuam aparecendo se eu não visualizar?"}],["$","i",null,{"className":"bi bi-plus-lg"}]]}],["$","p",null,{"children":"Os alertas operacionais importantes permanecem disponíveis até serem vistos. Depois que um prazo configurado é atingido, os lembretes podem reaparecer até duas vezes por dia, inclusive para orçamentos arquivados. A loja também pode iniciar o aplicativo com o Windows para manter o acompanhamento ativo."}]]}]
1d:["$","details","Consigo importar clientes e restaurar um backup?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"Consigo importar clientes e restaurar um backup?"}],["$","i",null,{"className":"bi bi-plus-lg"}]]}],["$","p",null,{"children":"Sim. A Central de Backup valida a integridade antes da restauração, permite cópia externa e oferece importação de clientes com revisão dos dados. A restauração e a importação exigem uma conta autorizada."}]]}]
1e:["$","details","Como funciona a transferência de dados?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"Como funciona a transferência de dados?"}],["$","i",null,{"className":"bi bi-plus-lg"}]]}],["$","p",null,{"children":"Atendimentos compatíveis recebem uma ficha própria para identificar aparelho de origem e destino, contas, números, autorizações e conferências. Campos vazios não aparecem no PDF, e credenciais digitadas não são salvas no cadastro, banco, backup ou nuvem."}]]}]
1f:["$","details","Como baixo e atualizo o aplicativo?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"Como baixo e atualizo o aplicativo?"}],["$","i",null,{"className":"bi bi-plus-lg"}]]}],["$","p",null,{"children":"O botão Baixar app consulta a release mais recente no repositório oficial. Depois de instalado, o aplicativo verifica pacotes assinados, pode prepará-los em segundo plano e conclui a instalação no fechamento. O canal beta é opcional."}]]}]
20:["$","details","É possível usar em celular?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"É possível usar em celular?"}],["$","i",null,{"className":"bi bi-plus-lg"}]]}],["$","p",null,{"children":"O aplicativo completo é para Windows. No celular, o técnico pode abrir o convite individual protegido e válido por 24 horas enviado pela assistência; esse recurso não substitui a instalação completa."}]]}]
21:["$","details","Posso usar mais de um usuário?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"Posso usar mais de um usuário?"}],["$","i",null,{"className":"bi bi-plus-lg"}]]}],["$","p",null,{"children":"Sim. Administradores podem criar operadores e configurar perfis como atendente, técnico, gerente ou personalizado, liberando apenas os grupos necessários."}]]}]
22:["$","details","Consigo mudar a pasta dos PDFs?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"Consigo mudar a pasta dos PDFs?"}],["$","i",null,{"className":"bi bi-plus-lg"}]]}],["$","p",null,{"children":"Sim. Os documentos são baixados automaticamente em Downloads por padrão, e uma conta administrativa pode escolher outra pasta nas Configurações."}]]}]
23:["$","details","O sistema envia a mensagem sozinho?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"O sistema envia a mensagem sozinho?"}],["$","i",null,{"className":"bi bi-plus-lg"}]]}],["$","p",null,{"children":"O aplicativo prepara e confere o texto no endereço do WhatsApp. O envio final depende da confirmação no próprio WhatsApp, preservando o controle do atendente."}]]}]
24:["$","div",null,{"className":"support-card","id":"suporte","children":[["$","div",null,{"className":"support-icon","children":["$","i",null,{"className":"bi bi-headset"}]}],["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"Suporte"}],["$","h2",null,{"children":"Precisa relatar um problema?"}],["$","p",null,{"children":"Informe a tela, a ação realizada e a mensagem exibida. Envie capturas sem dados pessoais de clientes. Para licença, informe apenas a mensagem de erro; não envie senhas, banco, backups ou documentos."}]]}],["$","$L6",null,{"className":"btn btn-outline-light","href":"/guia#atualizacoes","children":"Ajuda com licença","prefetch":false}]]}]
