{
  "name": "sites-project",
  "version": "9.5.3",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "config:sync": "node tools/sync-public-config.mjs",
    "icons:build": "node tools/generate-icon-subset.mjs",
    "predev": "npm run config:sync && npm run icons:build",
    "dev": "vinext dev",
    "prebuild": "npm run config:sync",
    "build": "node tools/build-public.mjs",
    "preview:public": "node tools/serve-public-build.mjs",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .openai",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:contract && pnpm run test:responsive",
    "test:contract": "node --test tests/site-contract.test.mjs tests/customer-pickup.test.mjs tests/catalog-share.test.mjs tests/catalog-price-editor.test.mjs tests/catalog-license-quota.test.mjs",
    "test:responsive": "playwright test",
    "catalog:deploy": "wrangler deploy --config wrangler.catalog.jsonc"
  },
  "dependencies": {
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.3",
    "@cloudflare/workers-types": "5.20260901.1",
    "@openai/sites-vite-plugin": "^0.2.0",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.8",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.128.0"
  },
  "type": "module"
}
