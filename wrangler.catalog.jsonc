{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "assistencia-simplificada-catalogo",
  "main": "cloudflare/catalog-api.ts",
  "compatibility_date": "2026-09-14",
  "workers_dev": false,
  "routes": [
    { "pattern": "catalogo.assistenciasimplificada.site", "custom_domain": true }
  ],
  "vars": {
    "SOURCE_SUPABASE_URL": "https://nbyezzdvxjcmlcejiiak.supabase.co",
    "SOURCE_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_52LqcgEDXaLjtiyo4P2jFQ_lw60xJFc"
  },
  "r2_buckets": [
    {
      "binding": "CATALOG_BUCKET",
      "bucket_name": "assistencia-simplificada-catalogo"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "CATALOG_LOCK", "class_name": "CatalogLock" }]
  },
  "migrations": [{ "tag": "v1-catalog-lock", "new_sqlite_classes": ["CatalogLock"] }]
}
